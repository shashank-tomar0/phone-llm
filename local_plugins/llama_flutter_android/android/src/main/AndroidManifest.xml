<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application>
        <!-- Phone cluster worker. Own process: ggml's RPC server can't be
             stopped, so stopping the worker ends this process. Runs as a
             plain started service; the app binds it for priority, and
             startForeground is best-effort (no FGS type is declared, so
             Android 14+ keeps it in the background while the app binds it). -->
        <service
            android:name=".ClusterWorkerService"
            android:enabled="true"
            android:exported="false"
            android:process=":cluster">
        </service>
    </application>
</manifest>
